{
    "name":"azatech/order-management-api",
    "type":"project",
    "require":{
        "php": "^8.3",
        "dedoc/scramble": "^0.13",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "predis/predis": "^3.7"
    },
    "require-dev":{
        "pestphp/pest":"^5.0",
        "pestphp/pest-plugin-laravel":"^5.0",
        "larastan/larastan":"^3.0",
        "laravel/pint":"^1.13",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5"
    },
    "autoload":{
        "psr-4":{
            "App\\":"app/",
            "Database\\Factories\\":"database/factories/",
            "Database\\Seeders\\":"database/seeders/"
        }
    },
    "autoload-dev":{
        "psr-4":{
            "Tests\\":"tests/"
        }
    },
    "scripts":{
        "test":"@php artisan test",
        "analyse":"./vendor/bin/phpstan analyse",
        "format":"./vendor/bin/pint"
    },
    "config":{
        "sort-packages":true,
        "allow-plugins":{
            "pestphp/pest-plugin":true
        }
    },
    "minimum-stability":"stable",
    "prefer-stable":true
}
